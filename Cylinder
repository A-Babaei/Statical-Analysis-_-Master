        try:
            if is_count:
                best_model, best_degree, dose_comp = compare_dose_response(metric, df, is_count=True)
                model_type = 'GEE (Fay-Graubard)'
                dose_type = {1:'linear', 2:'quadratic', 3:'cubic'}[best_degree]
                # Save dose-response comparison
                dose_comp['metric'] = metric
                dose_comp.to_excel(os.path.join(OUTPUT_DIR, "Tables", f"DoseResponse_Comparison_{metric}.xlsx"), index=False)
                # Extract fixed effects with corrected SE
                params = best_model.params
                se = best_model.bse_fg
                pvals = best_model.pvalues_fg
                fe = pd.DataFrame({'term': params.index, 'coef': params.values, 'se': se, 'p_value': pvals})
                fe['IRR'] = np.exp(fe['coef'])
                fe['IRR_low'] = np.exp(fe['coef'] - 1.96*fe['se'])
                fe['IRR_high'] = np.exp(fe['coef'] + 1.96*fe['se'])
                for term in fe['term']:
                    if any(x in term for x in ['C(PW_us)', 'PA_cent', ':']):
                        all_main_p.append(fe.loc[fe['term']==term, 'p_value'].values[0])
                all_quad_p.append(dose_comp.loc[dose_comp['degree']==best_degree, 'AICc'].values[0])
            else:
                # Use best model from duration comparison
                best_model, best_name = duration_best_models[metric]
                best_model, best_degree, dose_comp = compare_dose_response(metric, df, is_count=False)
                dose_type = {1:'linear', 2:'quadratic', 3:'cubic'}[best_degree]
                dose_comp['metric'] = metric
                dose_comp.to_excel(os.path.join(OUTPUT_DIR, "Tables", f"DoseResponse_Comparison_{metric}.xlsx"), index=False)
                model_type = best_name
                if hasattr(best_model, 'params'):
                    params = best_model.params
                    se = best_model.bse if hasattr(best_model, 'bse') else np.nan*params
                    pvals = best_model.pvalues if hasattr(best_model, 'pvalues') else np.nan
                    fe = pd.DataFrame({'term': params.index if hasattr(params, 'index') else range(len(params)),
                                       'coef': params.values if hasattr(params, 'values') else params,
                                       'se': se, 'p_value': pvals})
                    # Add R2 for LMM
                    if hasattr(best_model, 'fittedvalues'):
                        var_fixed = np.var(best_model.fittedvalues)
                        var_resid = best_model.scale if hasattr(best_model, 'scale') else np.var(best_model.resid)
                        marginal_r2 = var_fixed / (var_fixed + var_resid) if (var_fixed+var_resid)>0 else np.nan
                        fe['marginal_R2'] = marginal_r2
                else:
                    fe = pd.DataFrame()
                all_quad_p.append(dose_comp.loc[dose_comp['degree']==best_degree, 'AICc'].values[0])
            if not fe.empty:
                fe['metric'] = metric
                fe['model_type'] = model_type
                fe['dose_response'] = dose_type
                fe['quadratic_p'] = np.nan
                master_rows.append(fe)
            # Save summary
            with open(os.path.join(OUTPUT_DIR, "Statistics", f"{metric}_summary.txt"), "w", encoding='utf-8') as f:
                f.write(str(best_model.summary()) if hasattr(best_model, 'summary') else str(best_model))
        except Exception as e:
            logging.error(f"Model failed for {metric}: {e}")
            print(f"  Model failed: {e}")

    if master_rows:
        combined = pd.concat(master_rows, ignore_index=True)
        combined['primary'] = combined['metric'].isin(PRIMARY_METRICS)
        combined['q_main'] = np.nan
        p_prim = combined.loc[combined['primary'] & combined['p_value'].notna(), 'p_value']
        if len(p_prim) > 0:
            _, q_prim, _, _ = multipletests(p_prim, method='fdr_bh')
            combined.loc[combined['primary'] & combined['p_value'].notna(), 'q_main'] = q_prim
        p_sec = combined.loc[~combined['primary'] & combined['p_value'].notna(), 'p_value']
        if len(p_sec) > 0:
            _, q_sec, _, _ = multipletests(p_sec, method='fdr_bh')
            combined.loc[~combined['primary'] & combined['p_value'].notna(), 'q_main'] = q_sec
        combined.to_excel(os.path.join(OUTPUT_DIR, "Tables", "Master_Results.xlsx"), index=False)
        fe_only = combined[['metric', 'term', 'coef', 'se', 'p_value', 'q_main', 'dose_response']]
        fe_only.to_excel(os.path.join(OUTPUT_DIR, "Tables", "Fixed_Effects.xlsx"), index=False)

    # Effect sizes
    effect_sizes = []
    for metric in PRIMARY_METRICS + SECONDARY_METRICS[:5]:
        if not has_sufficient_data(df, metric, min_obs=2):
            continue
        for pa in sorted(df['PA_uA'].unique()):
            dz, g_rm, ci_dz_l, ci_dz_h, ci_g_l, ci_g_h = repeated_measures_effect_sizes(metric, df, pa)
            if not np.isnan(dz):
                effect_sizes.append({'Metric': metric, 'PA_uA': pa, 'Cohen_dz': dz, 'dz_CI_low': ci_dz_l, 'dz_CI_high': ci_dz_h,
                                     'Hedges_g_rm': g_rm, 'g_rm_CI_low': ci_g_l, 'g_rm_CI_high': ci_g_h})
    if effect_sizes:
        pd.DataFrame(effect_sizes).to_excel(os.path.join(OUTPUT_DIR, "Tables", "Effect_Sizes.xlsx"), index=False)

    # Sensitivity analyses (primary metrics only)
    for metric in PRIMARY_METRICS:
        if metric not in ALL_METRICS:
            continue
        is_count = metric in COUNT_METRICS
        if is_count:
            best_model, best_deg, _ = compare_dose_response(metric, df, is_count=True)
            use_quad = (best_deg >= 2)
            sens = leave_one_subject_out(metric, df, 'count', use_quadratic=use_quad)
            sens.to_excel(os.path.join(OUTPUT_DIR, "Sensitivity", f"LOSO_{metric}.xlsx"), index=False)
        else:
            sens = leave_one_subject_out(metric, df, 'duration')
            sens.to_excel(os.path.join(OUTPUT_DIR, "Sensitivity", f"LOSO_{metric}.xlsx"), index=False)
            sens_const = sensitivity_log_constant(metric, df)
            sens_const.to_excel(os.path.join(OUTPUT_DIR, "Sensitivity", f"LogConstant_{metric}.xlsx"), index=False)

    # ============================================================================
    # Figure 2: Primary outcomes – with clear panel titles (A, B, C, D)
    # ============================================================================
    plt.rcParams.update({
        'font.family': 'Arial',
        'font.size': 11,
        'axes.labelsize': 11,
        'axes.titlesize': 12,
        'xtick.labelsize': 9,
        'ytick.labelsize': 9,
        'legend.fontsize': 10,
        'lines.linewidth': 2.0,
        'axes.linewidth': 1.2,
        'pdf.fonttype': 42,
        'svg.fonttype': 'none'
    })

    fig2 = plt.figure(figsize=(12, 10))
    gs = GridSpec(2, 2, figure=fig2, hspace=0.35, wspace=0.35)

    # Style mapping for 60 and 90 µs
    style_map = {
        60: {'color': 'black', 'linestyle': '-', 'label': '60 µs'},
        90: {'color': 'orange', 'linestyle': '--', 'label': '90 µs'}
    }

    # ---- Panel A: Contralateral count (raw means) ----
    ax1 = fig2.add_subplot(gs[0, 0])
    for pw in [60, 90]:
        sub = df[df['PW_us'] == pw].groupby('PA_uA')['Contralateral'].agg(['mean', 'sem'])
        ax1.errorbar(sub.index, sub['mean'], yerr=1.96*sub['sem'],
                    color=style_map[pw]['color'], linestyle=style_map[pw]['linestyle'],
                    label=style_map[pw]['label'], linewidth=2, capsize=4)
    ax1.set_xlabel('Amplitude (µA)')
    ax1.set_ylabel('Contralateral touches')
    ax1.legend(loc='upper right', frameon=True)
    ax1.set_title('A: Contralateral touches (observed means)', loc='left', fontweight='bold', fontsize=13)

    # ---- Panel B: Contralateral duration (log scale) ----
    ax2 = fig2.add_subplot(gs[0, 1])
    for pw in [60, 90]:
        sub = df[df['PW_us'] == pw].groupby('PA_uA')['Contralateral_T'].agg(['mean', 'sem'])
        ax2.errorbar(sub.index, sub['mean'], yerr=1.96*sub['sem'],
                    color=style_map[pw]['color'], linestyle=style_map[pw]['linestyle'],
                    label=style_map[pw]['label'], linewidth=2, capsize=4)
    ax2.set_yscale('log')
    ax2.set_xlabel('Amplitude (µA)')
    ax2.set_ylabel('Duration (s) [log scale]')
    ax2.legend(loc='upper right', frameon=True)
    ax2.set_title('B: Contralateral duration (observed means)', loc='left', fontweight='bold', fontsize=13)

    # ---- Panel C: Combined dose‑response (EMM) ----
    ax3 = fig2.add_subplot(gs[1, 0])
    model_cnt, _ = fit_count_gee_fay_graubard('Contralateral', df, use_quadratic=False)
    pa_vals = np.linspace(0, 200, 30)
    grid = pd.DataFrame({'PW_us': 60, 'PA_uA': pa_vals})
    grid['PA_cent'] = grid['PA_uA'] - df['PA_uA'].mean()

    for pw, sty in style_map.items():
        grid['PW_us'] = pw
        pred, ci_low, ci_high = predict_emmeans(model_cnt, grid, is_count=True, is_gee=True)
        ax3.plot(pa_vals, pred, color=sty['color'], linestyle=sty['linestyle'],
                label=sty['label'], linewidth=2.5)
        ax3.fill_between(pa_vals, ci_low, ci_high, alpha=0.2, color=sty['color'])
    ax3.set_xlabel('Amplitude (µA)')
    ax3.set_ylabel('Contralateral touches (EMM)')
    ax3.legend(loc='upper right', frameon=True)
    ax3.set_title('C: Dose‑response (model‑based EMM)', loc='left', fontweight='bold', fontsize=13)

    # ---- Panel D: Interaction heatmap ----
    ax4 = fig2.add_subplot(gs[1, 1])
    heat_data = df.pivot_table(index='PW_us', columns='PA_uA', values='Contralateral', aggfunc='mean')
    sns.heatmap(heat_data, annot=True, fmt='.1f', cmap='viridis', ax=ax4,
                annot_kws={'size': 9}, cbar_kws={'shrink': 0.8, 'label': 'Mean contralateral touches'})
    ax4.set_xlabel('Amplitude (µA)')
    ax4.set_ylabel('Pulse width (µs)')
    ax4.tick_params(labelsize=9)
    ax4.set_title('D: PW × amplitude interaction', loc='left', fontweight='bold', fontsize=13)

    plt.tight_layout()
    safe_savefig(fig2, "Figure2_PrimaryOutcomes", os.path.join(OUTPUT_DIR, "Figures"))
    plt.close(fig2)

