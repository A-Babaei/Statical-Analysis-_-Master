# ============================================================================
# Overdispersion assessment (for counts)
# ============================================================================
def overdispersion_assessment(metric, df):
    y = df[metric].dropna()
    if len(y) < 2:
        return None
    mu = np.mean(y)
    var = np.var(y, ddof=1)
    pearson_chi2 = np.sum((y - mu)**2 / mu) if mu > 0 else np.nan
    df_pearson = len(y) - 1
    overdispersion_ratio = pearson_chi2 / df_pearson if df_pearson > 0 else np.nan
    p_od = 1 - chi2.cdf(pearson_chi2, df_pearson) if not np.isnan(pearson_chi2) else np.nan
    try:
        X = dmatrix("1", df.loc[df[metric].notna()], return_type='dataframe')
        nb = NegativeBinomialP(endog=y, exog=X).fit(disp=0)
        alpha = nb.params.get('alpha', np.nan)
    except:
        alpha = np.nan
    return pd.DataFrame([{
        'metric': metric,
        'mean': mu,
        'variance': var,
        'overdispersion_ratio': overdispersion_ratio,
        'pearson_chi2': pearson_chi2,
        'df': df_pearson,
        'p_value_overdispersion': p_od,
        'NB_alpha': alpha
    }])

# ============================================================================
# Count distribution selection (Poisson vs NB)
# ============================================================================
def select_count_distribution(metric, df):
    y = df[metric].dropna()
    X = dmatrix("C(PW_us) * PA_cent", df.loc[df[metric].notna()], return_type='dataframe')
    try:
        pois = sm.GLM(y, X, family=sm.families.Poisson()).fit()
        aic_pois = pois.aic
    except:
        aic_pois = np.inf
    try:
        nb = NegativeBinomialP(endog=y, exog=X).fit(disp=0)
        aic_nb = nb.aic
    except:
        aic_nb = np.inf
    return 'NegativeBinomial' if aic_nb < aic_pois else 'Poisson'

# ============================================================================
# GEE with validated Fay-Graubard correction (from audit)
# ============================================================================
def fit_count_gee_fay_graubard(metric, df, use_quadratic=False):
    df_sub = df[df[metric].notna()].copy()
    if use_quadratic:
        formula = f"{metric} ~ C(PW_us) * (PA_cent + PA_quad)"
    else:
        formula = f"{metric} ~ C(PW_us) * PA_cent"
    family_name = select_count_distribution(metric, df_sub)
    family = NegativeBinomial() if family_name == 'NegativeBinomial' else Poisson()
    model = GEE.from_formula(formula, groups=df_sub["Subject"], data=df_sub,
                             cov_struct=Exchangeable(), family=family)
    X = model.exog  # design matrix before fit
    result = model.fit()
    if not result.converged:
        logging.warning(f"GEE for {metric} did not converge.")
        return result, family_name

    # Fay-Graubard correction
    try:
        XTX_inv = np.linalg.pinv(X.T @ X)
    except:
        XTX_inv = np.linalg.inv(X.T @ X + np.eye(X.shape[1])*1e-8)
    H = X @ XTX_inv @ X.T
    hii = np.diag(H)
    resid = result.resid_pearson
    with np.errstate(divide='ignore', invalid='ignore'):
        adj_resid = resid / np.sqrt(1 - hii + 1e-12)  # add small epsilon
        adj_resid[~np.isfinite(adj_resid)] = 0
    meat = np.zeros((X.shape[1], X.shape[1]))
    for i in range(len(X)):
        xi = X[i, :][:, np.newaxis]
        meat += (adj_resid[i]**2) * (xi @ xi.T)
    cov_fg = XTX_inv @ meat @ XTX_inv
    param_names = result.params.index
    cov_fg_df = pd.DataFrame(cov_fg, index=param_names, columns=param_names)
    result.cov_params_fg = cov_fg_df
    result.bse_fg = np.sqrt(np.diag(cov_fg_df))
    result.pvalues_fg = 2 * (1 - norm.cdf(np.abs(result.params / result.bse_fg)))
    return result, family_name

# ============================================================================
# Duration model comparison (LMM raw, Gamma, Tweedie, Lognormal)
# ============================================================================
def fit_gamma_mixed(metric, df):
    df_sub = df[df[metric].notna()].copy()
    formula = f"{metric} ~ C(PW_us) * PA_cent"
    try:
        model = GEE.from_formula(formula, groups=df_sub["Subject"], data=df_sub,
                                 cov_struct=Exchangeable(), family=Gamma(link=sm.families.links.Log()))
        result = model.fit()
        return result
    except:
        return None

def fit_tweedie_mixed(metric, df, var_power=1.5):
    df_sub = df[df[metric].notna()].copy()
    formula = f"{metric} ~ C(PW_us) * PA_cent"
    try:
        tweedie = sm.families.Tweedie(var_power=var_power, link=sm.families.links.Log())
        model = GEE.from_formula(formula, groups=df_sub["Subject"], data=df_sub,
                                 cov_struct=Exchangeable(), family=tweedie)
        result = model.fit()
        return result
    except:
        return None

def fit_lognormal_mixed(metric, df, log_constant=0.1):
    df_sub = df[df[metric].notna()].copy()
    df_sub['logY'] = np.log(df_sub[metric] + log_constant)
    try:
        model = mixedlm("logY ~ C(PW_us) * PA_cent", df_sub, groups=df_sub["Subject"], re_formula="1")
        result = model.fit()
        return result
    except:
        return None

def fit_linear_mixed(metric, df):
    df_sub = df[df[metric].notna()].copy()
    try:
        model = mixedlm(f"{metric} ~ C(PW_us) * PA_cent", df_sub, groups=df_sub["Subject"], re_formula="1")
        result = model.fit()
        return result
    except:
        return None

def compare_duration_models(metric, df, log_constant=0.1):
    models = {
        'Linear Mixed (raw)': fit_linear_mixed(metric, df),
        'Gamma Mixed': fit_gamma_mixed(metric, df),
        'Tweedie Mixed (p=1.5)': fit_tweedie_mixed(metric, df, var_power=1.5),
        'Lognormal Mixed': fit_lognormal_mixed(metric, df, log_constant)
    }
    results = []
    for name, model in models.items():
        if model is None:
            results.append({'model': name, 'AIC': np.nan, 'BIC': np.nan, 'logL': np.nan, 'converged': False})
            continue
        if hasattr(model, 'llf'):
            logL = model.llf
            k = len(model.params)
            n = len(model.resid)
            aic = -2*logL + 2*k
            bic = -2*logL + k*np.log(n)
        else:
            logL = getattr(model, 'llf', np.nan)
            aic = getattr(model, 'aic', np.nan)
            bic = getattr(model, 'bic', np.nan)
        results.append({'model': name, 'AIC': aic, 'BIC': bic, 'logL': logL, 'converged': True})
    df_comp = pd.DataFrame(results)
    # Select by AIC
    best_idx = df_comp['AIC'].idxmin()
    df_comp['delta_AIC'] = df_comp['AIC'] - df_comp.loc[best_idx, 'AIC']
    df_comp['Akaike_weight'] = np.exp(-0.5 * df_comp['delta_AIC']) / np.sum(np.exp(-0.5 * df_comp['delta_AIC']))
    best_model_name = df_comp.loc[best_idx, 'model']
    best_model = models[best_model_name]
    return df_comp, best_model, best_model_name

def duration_model_diagnostics(metric, best_model, output_dir):
    if best_model is None:
        return
    if hasattr(best_model, 'resid_pearson'):
        resid = best_model.resid_pearson
    elif hasattr(best_model, 'resid'):
        resid = best_model.resid
    else:
        return
    fig, axes = plt.subplots(1, 2, figsize=(8, 4))
    axes[0].hist(resid, bins=15, density=True, alpha=0.7)
    axes[0].set_title(f'{metric} - Residuals')
    qqplot(resid, line='s', ax=axes[1])
    axes[1].set_title('Q-Q plot')
    safe_savefig(fig, f"ModelDiagnostics_{metric}", os.path.join(output_dir, "Diagnostics"))
    plt.close(fig)

# ============================================================================
# Information-theoretic dose-response selection (linear/quadratic/cubic)
# ============================================================================
def compare_dose_response(metric, df, is_count=True, max_degree=3):
    models = {}
    aicc = {}
    for deg in range(1, max_degree+1):
        if deg == 1:
            formula = f"{metric} ~ C(PW_us) * PA_cent"
            use_quad = False
        elif deg == 2:
            formula = f"{metric} ~ C(PW_us) * (PA_cent + PA_quad)"
            use_quad = True
        else:  # cubic
            formula = f"{metric} ~ C(PW_us) * (PA_cent + PA_quad + PA_cubic)"
            use_quad = True
        if is_count:
            model, _ = fit_count_gee_fay_graubard(metric, df, use_quadratic=use_quad)
        else:
            # Use Lognormal mixed as default for fair comparison
            model = fit_lognormal_mixed(metric, df)
        if model is not None:
            models[deg] = model
            if hasattr(model, 'llf'):
                logL = model.llf
                k = len(model.params)
                n = len(model.resid)
                aic = -2*logL + 2*k
                aic_c = aic + (2*k*(k+1))/(n - k - 1) if n > k+1 else aic
            else:
                aic_c = getattr(model, 'aic', np.nan)
            aicc[deg] = aic_c
    if not aicc:
        return None, 1, pd.DataFrame()
    df_dr = pd.DataFrame({'degree': list(aicc.keys()), 'AICc': list(aicc.values())})
    best_deg = df_dr.loc[df_dr['AICc'].idxmin(), 'degree']
    df_dr['delta_AICc'] = df_dr['AICc'] - df_dr['AICc'].min()
    df_dr['Akaike_weight'] = np.exp(-0.5 * df_dr['delta_AICc']) / np.sum(np.exp(-0.5 * df_dr['delta_AICc']))
    return models[best_deg], best_deg, df_dr

# ============================================================================
# Model-based predictions (EMMeans) – works with both GEE and LMM
# ============================================================================
def predict_emmeans(model, newdata, is_count=True, is_gee=True):
    if is_gee:
        if hasattr(model, 'cov_params_fg'):
            cov = model.cov_params_fg
        else:
            cov = model.cov_params()
        if isinstance(cov, np.ndarray):
            param_names = model.params.index
            cov = pd.DataFrame(cov, index=param_names, columns=param_names)
        formula = model.model.formula
        rhs = formula.split('~')[1] if '~' in formula else formula
        design = dmatrix(rhs, newdata, return_type='dataframe')
        common = [c for c in model.params.index if c in design.columns]
        design_aligned = design[common]
        lin_pred = design_aligned @ model.params[common].values
        var_lin = np.diag(design_aligned @ cov.loc[common, common] @ design_aligned.T)
        se_lin = np.sqrt(var_lin)
        if is_count:
            pred = np.exp(lin_pred)
            se = se_lin * pred
        else:
            pred = np.exp(lin_pred)
            se = se_lin * pred
        ci_low = pred - 1.96*se
        ci_high = pred + 1.96*se
        return pred, ci_low, ci_high
    else:
        if hasattr(model, 'predict'):
            pred = model.predict(newdata)
            if hasattr(model, 'mse_resid'):
                se = np.sqrt(model.mse_resid) * np.ones_like(pred)
                ci_low = pred - 1.96*se
                ci_high = pred + 1.96*se
                return pred, ci_low, ci_high
        return None, None, None

# ============================================================================
# Repeated-measures effect sizes
# ============================================================================
def repeated_measures_effect_sizes(metric, df, pa_value):
    subj60 = df[(df['PW_us']==60) & (df['PA_uA']==pa_value)][['Subject', metric]].set_index('Subject')
    subj90 = df[(df['PW_us']==90) & (df['PA_uA']==pa_value)][['Subject', metric]].set_index('Subject')
    paired = subj60.join(subj90, lsuffix='_60', rsuffix='_90').dropna()
    if len(paired) < 2:
        return np.nan, np.nan, np.nan, np.nan, np.nan, np.nan
    d = paired[metric+'_60'] - paired[metric+'_90']
    cohen_dz = np.mean(d) / np.std(d, ddof=1)
    n = len(d)
    hedges_g_rm = cohen_dz * (1 - 3/(4*n - 1))
    def boot_stat(data):
        boot_d = np.random.choice(data, size=len(data), replace=True)
        return np.mean(boot_d) / np.std(boot_d, ddof=1)
    boot_ci = bootstrap((d,), boot_stat, n_resamples=2000, method='BCa', random_state=42)
    def boot_stat_hedges(data):
        boot_d = np.random.choice(data, size=len(data), replace=True)
        n_boot = len(boot_d)
        J = 1 - 3/(4*n_boot - 1)
        return (np.mean(boot_d) / np.std(boot_d, ddof=1)) * J
    boot_ci_hedges = bootstrap((d,), boot_stat_hedges, n_resamples=2000, method='BCa', random_state=42)
    return (cohen_dz, hedges_g_rm, boot_ci.confidence_interval[0], boot_ci.confidence_interval[1],
            boot_ci_hedges.confidence_interval[0], boot_ci_hedges.confidence_interval[1])

# ============================================================================
# Sensitivity analyses
# ============================================================================
def leave_one_subject_out(metric, df, outcome_type='count', use_quadratic=False):
    subjects = df['Subject'].unique()
    coefs = []
    for subj in subjects:
        train = df[df['Subject'] != subj].copy()
        try:
            if outcome_type == 'count':
                model, _ = fit_count_gee_fay_graubard(metric, train, use_quadratic=use_quadratic)
                coef = model.params.get('C(PW_us)[T.90]:PA_cent', np.nan)
            else:
                model = fit_lognormal_mixed(metric, train)
                if hasattr(model, 'params') and 'C(PW_us)[T.90]:PA_cent' in model.params:
                    coef = model.params['C(PW_us)[T.90]:PA_cent']
                else:
                    coef = np.nan
            coefs.append({'Left_out': subj, 'coef_interaction': coef})
        except:
            coefs.append({'Left_out': subj, 'coef_interaction': np.nan})
    return pd.DataFrame(coefs)

def sensitivity_log_constant(metric, df, constants=[0.01, 0.05, 0.1, 0.2, 0.5]):
    results = []
    for c in constants:
        try:
            model = fit_lognormal_mixed(metric, df, log_constant=c)
            if hasattr(model, 'params') and 'PA_cent' in model.params:
                coef = model.params['PA_cent']
            else:
                coef = np.nan
            results.append({'log_constant': c, 'PA_cent_coef': coef})
        except:
            results.append({'log_constant': c, 'PA_cent_coef': np.nan})
    return pd.DataFrame(results)

