    with open(os.path.join(OUTPUT_DIR, "Reports", "Analysis_report.txt"), "w") as f:
        f.write("DBS CYLINDER TEST – NATURE COMMUNICATIONS ADVANCED ANALYSIS\n")
        f.write("="*70 + "\n")
        f.write(f"Subjects: {df['Subject'].nunique()}\n")
        f.write(f"Observations: {len(df)}\n")
        f.write(f"Metrics analyzed: {len(ALL_METRICS)}\n\n")
        f.write("Statistical methods:\n")
        f.write("  - Count outcomes: GEE with exchangeable correlation, Fay-Graubard small-sample correction.\n")
        f.write("  - Duration outcomes: Model comparison (LMM raw, Gamma, Tweedie, lognormal) with AIC selection.\n")
        f.write("  - Dose-response: Information-theoretic selection (linear/quadratic/cubic) using AICc and Akaike weights.\n")
        f.write("  - Multiple testing: hierarchical FDR (primary vs secondary).\n")
        f.write("  - Effect sizes: Cohen's dz and repeated-measures Hedges g with bootstrap CIs.\n")
        f.write("  - Sensitivity: leave-one-subject-out, log-constant variation.\n")
        f.write("Figures: vector PDF/SVG, Arial font, Nature Communications style.\n")

    with open(os.path.join(OUTPUT_DIR, "Reports", "Methods_for_Manuscript.txt"), "w") as f:
        f.write("METHODS\n\n")
        f.write("Statistical analysis.\n")
        f.write("Count outcomes were analysed using GEE with exchangeable correlation and Fay-Graubard (2001) bias-reduced standard errors. The distribution (Poisson vs negative binomial) was selected by AIC. Duration outcomes were compared among four mixed models (linear raw, gamma with log link, Tweedie with variance power 1.5, and lognormal) using GEE or linear mixed models as appropriate; the model with lowest AIC was retained. Dose-response relationships (linear, quadratic, cubic) were compared using AICc and Akaike weights. Hierarchical false discovery rate (FDR) controlled for primary (Contralateral, Contralateral_T) and secondary outcomes separately. Effect sizes were Cohen's dz and repeated-measures Hedges g with bias-corrected bootstrap confidence intervals. Sensitivity analyses included leave-one-subject-out and variation of the log transformation constant. All figures were produced in Python 3.11 with Matplotlib and Seaborn, exported as vector PDF and SVG with Arial font.\n")

    print("\nAnalysis completed successfully.")
    print(f"Results saved in: {OUTPUT_DIR}")

