def has_sufficient_data(df, metric, min_obs=5, min_subjects=3):
    non_na = df[metric].dropna()
    if len(non_na) < min_obs:
        return False
    if np.var(non_na) == 0:
        return False
    subjects_with_data = df.loc[df[metric].notna(), 'Subject'].nunique()
    return subjects_with_data >= min_subjects

