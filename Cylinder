def load_data():
    df = pd.read_excel(INPUT_FILE, engine='openpyxl')
    df['Subject'] = df['Subject'].astype(str)
    df['PW_us'] = df['PW_us'].astype('category')
    df['PA_uA'] = pd.to_numeric(df['PA_uA'], errors='coerce')
    df['PA_cent'] = df['PA_uA'] - df['PA_uA'].mean()
    df['PA_quad'] = df['PA_cent']**2
    df['PA_cubic'] = df['PA_cent']**3
    for m in ALL_METRICS:
        df[m] = pd.to_numeric(df[m], errors='coerce')
    return df

