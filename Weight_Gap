ax.set_title('Weight Distribution by Phase and Group', fontsize=14, fontweight='bold')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig(os.path.join(output_dirs['figures'], 'Weight_Boxplot.png'))
plt.close()

print("\n" + "="*80)
print("ANALYSIS COMPLETE")
print("="*80)
print(f"\nResults saved to: {output_base}")
print(f"  - Figures: {output_dirs['figures']}")
print(f"  - Tables: {output_dirs['tables']}")
print(f"  - Statistics: {output_dirs['stats']}")
print("\n" + "="*80)
print("KEY FINDINGS")
print("="*80)
print(f"  R² Marginal:     {r2_marginal:.4f} (fixed effects explain {r2_marginal*100:.1f}% of variance)")
print(f"  R² Conditional:  {r2_conditional:.4f} (fixed + random explain {r2_conditional*100:.1f}% of variance)")
print(f"  ICC:             {icc:.4f} ({icc*100:.1f}% of variance is between-subject)")
print("="*80)
