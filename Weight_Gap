    ax.errorbar(range(len(means)), means, yerr=sems, 
                marker='o', capsize=5, label=group, linewidth=2)

ax.set_xticks(range(len(phases)))
ax.set_xticklabels(phases, rotation=45)
ax.set_xlabel('Phase', fontsize=12)
ax.set_ylabel('Weight (g)', fontsize=12)
ax.set_title('Weight Trajectory by Group', fontsize=14, fontweight='bold')
ax.legend()
